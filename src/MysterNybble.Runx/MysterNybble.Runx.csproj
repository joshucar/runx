<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <IsTestProject>false</IsTestProject>
    <ToolCommandName>runx</ToolCommandName>
    <PackageId>MysterNybble.Runx</PackageId>
    <Version>1.0.0-beta.1</Version>
    <Authors>MysterNybble</Authors>
    <Description>A repo command runner for .NET projects.</Description>
    <PackageProjectUrl>https://github.com/joshucar/runx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joshucar/runx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet-tool;cli;task-runner;build;automation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MysterNybble.Runx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Guide.md" LogicalName="MysterNybble.Runx.Guide.md" />
    <EmbeddedResource Include="Resources\SKILL.md" LogicalName="MysterNybble.Runx.SKILL.md" />
  </ItemGroup>

</Project>
