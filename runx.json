{
  "$schema": "./schemas/v1/runx.schema.json",
  "version": 1,
  "tasks": {
    "build": {
      "description": "Build the solution in Release configuration.",
      "command": "dotnet",
      "args": ["build", "runx.slnx", "--configuration", "Release"]
    },
    "test": {
      "description": "Build, then run the test suite.",
      "command": "dotnet",
      "args": ["test", "--configuration", "Release", "--no-build"],
      "dependsOn": ["build"]
    },
    "pack": {
      "description": "Pack the runx tool into artifacts/packages.",
      "command": "dotnet",
      "args": ["pack", "src/MysterNybble.Runx", "--configuration", "Release", "--no-build", "--output", "artifacts/packages"],
      "dependsOn": ["build"]
    },
    "smoke": {
      "description": "Install and smoke test the packed tool in isolation.",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "eng/smoke-test.ps1"],
      "dependsOn": ["pack"]
    },
    "ci": {
      "description": "Build, test, pack, and smoke test the tool.",
      "dependsOn": ["test", "smoke"]
    },
    "tool:uninstall": {
      "description": "Uninstall the global runx tool.",
      "command": "dotnet",
      "args": ["tool", "uninstall", "--global", "MysterNybble.Runx"]
    }
  }
}
