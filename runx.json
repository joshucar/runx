{
  "$schema": "./schemas/v1/runx.schema.json",
  "version": 1,
  "tasks": {
    "build": {
      "description": "Build the solution.",
      "command": "dotnet",
      "args": ["build"]
    },
    "test": {
      "description": "Build, then run the test suite.",
      "command": "dotnet",
      "args": ["test", "--no-build"],
      "dependsOn": ["build"]
    },
    "pack": {
      "description": "Pack the runx tool into artifacts/packages.",
      "command": "dotnet",
      "args": ["pack", "src/MysterNybble.Runx", "--configuration", "Release", "--output", "artifacts/packages"]
    },
    "ci": {
      "description": "Build, test, and pack.",
      "dependsOn": ["test", "pack"]
    },
    "tool:uninstall": {
      "description": "Uninstall the global runx tool.",
      "command": "dotnet",
      "args": ["tool", "uninstall", "--global", "MysterNybble.Runx"]
    }
  }
}
